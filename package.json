{
  "name": "@ciag/observability",
  "version": "0.1.0",
  "description": "Observabilidade padrão CIAg (OpenTelemetry + protocolo Sentry) para NestJS e Angular, com redação de PII (LGPD).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "import": "./dist/nest/index.js",
      "require": "./dist/nest/index.cjs"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nest": [
        "./dist/nest/index.d.ts"
      ],
      "angular": [
        "./dist/angular/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-dist.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "node scripts/contract-test.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:contract",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.6"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
